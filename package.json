{
	"name": "cloud",
	"type": "module",
	"private": true,
	"scripts": {
		"---DEFAULT---": "exit 0",
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"---PRETTIER---": "exit 0",
		"prettier:check": "prettier --check .",
		"prettier:write": "prettier --write .",
		"---ESTLINT---": "exit 0",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "husky"
	},
	"dependencies": {
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@nuxt/eslint": "1.9.0",
		"@quasar/extras": "^1.17.0",
		"eslint": "^9.38.0",
		"nuxt": "^4.2.0",
		"nuxt-quasar-ui": "2.1.13",
		"quasar": "^2.18.5",
		"vue": "^3.5.22",
		"vue-router": "^4.6.3"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^16.2.6",
		"prettier": "3.6.2",
		"typescript": "^5.9.3",
		"vue-tsc": "^3.1.2"
	},
	"lint-staged": {
		"*.{js,ts,vue}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"engines": {
		"node": ">=22.12.0",
		"bun": ">=1.2.20"
	}
}
